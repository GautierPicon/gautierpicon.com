---
const pageTitle = "Gautier Picon's Portfolio";

import Layout from '../layouts/Layout.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LinkButton from '../components/LinkButton.svelte';
import linksData from '../data/links.json';
import walkingDuck from '../assets/walkingDuck.gif';

const iconModules = import.meta.glob<{ default: ImageMetadata }>('../assets/linksIcons/*', {
  eager: true
});

const iconMap: Record<string, ImageMetadata> = {};
for (const [path, module] of Object.entries(iconModules)) {
  const filename = path.split('/').pop();
  if (filename) iconMap[filename] = module.default;
}

const links = linksData.map((link) => ({
  ...link,
  iconSrc: iconMap[link.icon]
}));
---

<Layout title={pageTitle}>
  <main
    class="bg-white min-h-screen overflow-y-auto flex items-center justify-center md:p-5 px-8 py-8 box-border"
  >
    <div class="flex flex-col items-center w-full max-w-[492px]">
      <button
        id="duck-btn"
        type="button"
        class="cursor-pointer w-[120px] h-[120px] sm:w-[160px] sm:h-[160px] md:w-[184px] md:h-[184px] rounded-[20px] overflow-hidden mb-4 sm:mb-6 border-none p-0 bg-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
        aria-label="Quack!"
      >
        <Image
          src={walkingDuck}
          alt="Walking duck"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </button>

      <h1
        class="uppercase font-bold text-[18px] sm:text-[20px] md:text-[36px] tracking-wider text-black text-center mb-2 whitespace-nowrap"
      >
        Gautier Picon
      </h1>

      <p
        class="font-normal text-[14px] sm:text-[16px] md:text-[20px] text-center text-black leading-tight max-w-[260px] sm:max-w-[280px] mb-6 sm:mb-10"
      >
        Design Engineer
      </p>

      <nav aria-label="Social links" class="w-full">
        <ul class="flex flex-col gap-3 sm:gap-4 list-none m-0 p-0">
          {
            links.map((link) => (
              <li>
                <LinkButton
                  title={link.name}
                  subtitle={link.description}
                  href={link.url}
                  icon={link.iconSrc.src}
                  invertOnHover={link.invertOnHover}
                />
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="text-xs text-gray-400 mt-4 sm:mt-6">
        Please read this before messaging:
        <a
          href="https://nohello.net"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-gray-500 underline focus-visible:outline-1 focus-visible:outline-black rounded"
        >
          nohello.net
        </a>
      </p>
    </div>
  </main>
</Layout>

<script>
  let quack: HTMLAudioElement | null = null;

  try {
    quack = new Audio('/quack.mp3');
    quack.preload = 'none';
  } catch (e) {
    console.warn('Audio not supported or quack.mp3 missing:', e);
  }

  document.getElementById('duck-btn')?.addEventListener('click', () => {
    if (!quack) return;
    quack.currentTime = 0;
    quack.play().catch(() => {});
  });
</script>
