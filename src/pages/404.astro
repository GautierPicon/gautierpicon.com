---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import duck404 from '../assets/404.png';

const pageTitle = "Gautier Picon's Portfolio";
---

<Layout title={pageTitle}>
  <div
    class="flex flex-col items-center justify-center mx-auto text-center gap-5 min-h-screen px-4"
  >
    <Image
      src={duck404}
      alt="Lost duck"
      class="max-w-[200px] h-auto block mx-auto"
      loading="eager"
    />
    <div class="text-4xl pt-5">
      <span class="font-bold">404:</span> Not found
    </div>
    <pre
      id="path-display"
      class="px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm font-mono text-gray-200"
    >
      Path: /
    </pre>

    <a
      href="/"
      class="mt-2 text-sm text-gray-400 hover:text-gray-600 underline transition-colors inline-flex items-center gap-1"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18"></path>
      </svg>
      Back to home
    </a>
  </div>
</Layout>

<script>
  const originalPath = document.referrer
    ? new URL(document.referrer).pathname
    : window.location.pathname;

  const displayPath =
    originalPath === '/404/' || originalPath === '/404' ? '(unknown path)' : originalPath;

  document.getElementById('path-display')!.textContent = `Path: ${displayPath}`;
</script>
